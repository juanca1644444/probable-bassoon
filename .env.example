# ==============================================================================
# CHASKYAPP - Production Environment Variables Configuration (.env)
# ==============================================================================

# Application Ports
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=3001

# Node Environment
NODE_ENV=production

# Security & Authentication
# Replace with a cryptographically secure random string in production (e.g., openssl rand -hex 32)
JWT_SECRET=chasky_super_secret_jwt_production_key_2026_replace_in_production
SESSION_TIMEOUT_MINUTES=15

# Google Gemini API Key (for Voice-to-Text, Real-time Translation, Sentiment & Smart AI features)
GEMINI_API_KEY=

# CORS Configuration (Set to your domain in production, e.g. https://app.chasky.pe)
CORS_ORIGIN=*

# Automated Database Backup Configuration
# Fernet / AES Encryption Key (Generate using: python scripts/backup_db.py --generate-key)
BACKUP_ENCRYPTION_KEY=JYXCCNYtVHBh3-2RdD5gdgnz2FPx0WS9E4Yx6KP4l-E=
BACKUP_RETENTION_DAYS=7
BACKUP_OUTPUT_DIR=./backups

# ─── Arquitectura Gratuita (Zero-Cost / Cloud Serverless) ────────────────────
# URL del backend para despliegues separados (ej: Frontend en Vercel -> Backend en Render)
# VITE_BACKEND_URL=https://chaskyapp-backend.onrender.com

# Google Drive (5 TB Backup Vault)
# Ruta al archivo de credenciales de Google Service Account
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
GDRIVE_BACKUP_FOLDER=CHASKYAPP_BACKUPS
GDRIVE_RETENTION_DAYS=30

# Google Sheets CRM & Leads Sync (Servicios Educativos Huiracocha)
# URL de la aplicación web de Google Apps Script (creada en 2 min sin costo)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec
